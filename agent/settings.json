{
  "theme": "kanagawa",
  "externalEditor": "nvim",
  "lastChangelogVersion": "0.84.0",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4-flash",
  "packages": [
    "npm:pi-mono-btw",
    "npm:pi-mono-clear",
    "npm:pi-mono-ask-user-question",
    "npm:pi-mono-context",
    "npm:pi-mono-context-guard",
    "npm:pi-mono-usage",
    "npm:pi-rtk-optimizer",
    "extensions/init-agents.ts",
    "npm:pi-web-access",
    "npm:@bacnh85/pi-ponytail",
    "npm:@narumitw/pi-btw",
    "npm:@tintinweb/pi-tasks",
    "npm:@leo-alvarenga/pi-agent-manager",
    "npm:@leo-alvarenga/pi-zen-frame",
    "npm:@leo-alvarenga/pi-hash-edit"
  ],
  "editorPaddingX": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always"
}