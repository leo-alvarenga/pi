{
  "theme": "kanagawa",
  "externalEditor": "nvim",
  "lastChangelogVersion": "0.87.1",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "packages": [
    "npm:pi-mono-btw",
    "npm:pi-mono-clear",
    "npm:pi-mono-ask-user-question",
    "npm:pi-mono-context",
    "npm:pi-mono-context-guard",
    "npm:pi-mono-usage",
    "npm:pi-rtk-optimizer",
    "extensions/init-agents.ts",
    "npm:pi-web-access",
    "npm:@bacnh85/pi-ponytail",
    "npm:@narumitw/pi-btw",
    "npm:pi-hashline-edit-pro",
    "npm:context-mode",
    "npm:@leo-alvarenga/pi-notify",
    "npm:pi-claude-bridge",
    "npm:@leo-alvarenga/pi-status-broadcaster",
    "../../personal/pi-mono/packages/pi-zen-frame",
    "npm:@leo-alvarenga/pi-mini-subagents",
    "npm:@leo-alvarenga/pi-todo-list",
    "npm:@llblab/pi-telegram",
    "npm:@leo-alvarenga/pi-qol"
